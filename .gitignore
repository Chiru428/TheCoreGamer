# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Next.js / Build outputs ──────────────────────────────────────────────────
.next/
dist/
out/

# ─── Test coverage ────────────────────────────────────────────────────────────
coverage/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Environment variables — NEVER commit real secrets ────────────────────────
.env
.env.*
!.env.example
!.env.test.example

# ─── OS / Editor artefacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Deployment / tooling caches ──────────────────────────────────────────────
.vercel
.turbo

# ─── Google service-account key files (keep inlined value out of VCS too) ─────
*service-account*.json
*service_account*.json
*-credentials.json
*-key.json
