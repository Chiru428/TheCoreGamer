# =============================================================================
# TheCoreGamer Frontend — Environment Variables
# -----------------------------------------------------------------------------
# HOW TO SET UP:
#   1. Copy this file:   cp .env.example .env.local
#   2. Fill in the values below
#   3. Make sure AUTH_SECRET is IDENTICAL to the one in backend/.env.local
#   4. Run:  npm run dev
# =============================================================================

# -----------------------------------------------------------------------------
# AUTH (required — must match backend AUTH_SECRET exactly)
# -----------------------------------------------------------------------------
# Generate a strong secret:  openssl rand -base64 32
AUTH_SECRET=your-random-secret-min-32-chars-CHANGE-THIS
# Must match backend INTERNAL_API_SECRET exactly
INTERNAL_API_SECRET=your-internal-api-secret-min-32-chars

# Public URL of this frontend (used by NextAuth for OAuth callbacks)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Canonical public URL of this site — used for SEO, OG images, sitemap, JSON-LD
# Change to your production domain in .env.local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# BACKEND
# -----------------------------------------------------------------------------
# Backend API base URL — used by SSR/RSC fetch and the NextAuth authorize() call
# (server-side only, NOT exposed to the browser)
BACKEND_URL=http://localhost:3001

# Backend API base URL — exposed to the browser for client-side fetches.
# Leave EMPTY in development — Next.js proxies /api/* to BACKEND_URL automatically.
# Only set to an absolute URL in production if the API is on a separate domain.
NEXT_PUBLIC_API_URL=

# -----------------------------------------------------------------------------
# OAUTH PROVIDERS (optional — leave blank to disable)
# -----------------------------------------------------------------------------
# Google: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# ANALYTICS & ADS (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID (https://clarity.microsoft.com) — enables heatmaps
# and session recordings. Loads only in production and only with analytics consent.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# AdSense publisher/client ID (e.g. ca-pub-1234567890123456). Leave blank to
# show placeholder ad slots instead of live AdSense units.
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXXX

# Numeric AdSense ad-unit slot IDs (e.g. 1234567890), one per zone defined in
# AD_ZONES (lib/constants.ts). A zone falls back to the placeholder unless both
# NEXT_PUBLIC_ADSENSE_ID and its slot ID below are set.
NEXT_PUBLIC_AD_SLOT_ADS_01=
NEXT_PUBLIC_AD_SLOT_ADS_02=
NEXT_PUBLIC_AD_SLOT_ADS_03=
NEXT_PUBLIC_AD_SLOT_ADS_04=
NEXT_PUBLIC_AD_SLOT_ADS_05=
NEXT_PUBLIC_AD_SLOT_ADS_06=
NEXT_PUBLIC_AD_SLOT_ADS_07=
NEXT_PUBLIC_AD_SLOT_ADS_08=

# Cloudflare R2 public CDN hostname (no protocol, e.g. files.yourdomain.com)
NEXT_PUBLIC_R2_HOST=

# -----------------------------------------------------------------------------
# STEAM (OpenID 2.0)
# -----------------------------------------------------------------------------
# Get your Steam API key at: https://steamcommunity.com/dev/apikey
# This is a server-side key used to fetch Steam player profiles after login.
STEAM_API_KEY=
# Set to "true" to show the "Continue with Steam" button on login/register pages.
NEXT_PUBLIC_STEAM_ENABLED=false

# -----------------------------------------------------------------------------
# EXTERNAL APIs
# -----------------------------------------------------------------------------
# IGDB game data is proxied through the backend (see backend/.env.example
# IGDB_CLIENT_ID / IGDB_CLIENT_SECRET) — no client-side key needed here.

# -----------------------------------------------------------------------------
# Push Notifications (VAPID)
# -----------------------------------------------------------------------------
# Must match VAPID_PUBLIC_KEY in backend/.env
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Algolia (Search)
# -----------------------------------------------------------------------------
# App ID + search-only API key from https://www.algolia.com/account/api-keys
# The search-only key is safe to expose to the browser.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
