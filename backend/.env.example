# =============================================================================
# TheCoreGamer Backend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in all values.

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Auth (NextAuth.js v5)
# -----------------------------------------------------------------------------
# AUTH_URL: the URL of THIS backend app (port 3001 in dev, your API domain in prod)
# Note: AUTH_SECRET must be identical to the one in frontend/.env.local — AUTH_URL does not.
AUTH_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
# Generate: openssl rand -base64 32
# Must be IDENTICAL to frontend AUTH_SECRET
AUTH_SECRET=your-random-secret-min-32-chars-CHANGE-THIS
NEXTAUTH_SECRET=${AUTH_SECRET}  # kept for compat
# Separate secret for on-demand ISR revalidation calls (/api/revalidate) — min 32 chars
REVALIDATE_SECRET=your-separate-revalidation-secret-min-32-chars
INTERNAL_API_SECRET=your-internal-api-secret-min-32-chars

# CSRF — set this to your production frontend URL
FRONTEND_URL=https://your-domain.com
# Set CSRF_STRICT=true to enforce strict CSRF checking in development
# (matches production behaviour — useful for integration tests)
CSRF_STRICT=false

# -----------------------------------------------------------------------------
# OAuth Providers
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Upstash Redis (Rate Limiting & Caching)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Redis (BullMQ Workers — requires standard Redis, not Upstash HTTP)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Mux (Video Streaming)
# -----------------------------------------------------------------------------
# Get your token at: https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Resend (Email)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=GameHub <noreply@yourdomain.com>
# Resend webhook signing secret (from Resend dashboard → Webhooks)
RESEND_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Cloudinary (Image CDN)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Cloudflare R2 (File Storage — S3-compatible)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gamehub-files
R2_PUBLIC_URL=https://files.yourdomain.com
# Cloudflare R2 CDN hostname WITHOUT protocol — used by Next.js Image & media URLs
# e.g. files.thecoregamer.com  (no https://)
NEXT_PUBLIC_R2_HOST=files.yourdomain.com

# -----------------------------------------------------------------------------
# Google APIs (Analytics & AdSense)
# -----------------------------------------------------------------------------
GOOGLE_ADSENSE_PUBLISHER_ID=pub-xxxxxxxxxxxxxxxx
GOOGLE_ANALYTICS_PROPERTY_ID=properties/xxxxxxxxx
# Paste the full JSON inline (keep it server-side only, never expose to browser)
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"YOUR_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"YOUR_SA@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"YOUR_CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/YOUR_SA%40YOUR_PROJECT.iam.gserviceaccount.com","universe_domain":"googleapis.com"}'

# -----------------------------------------------------------------------------
# IGDB (Game Data & Metadata — via Twitch OAuth)
# -----------------------------------------------------------------------------
# Create a Twitch application at https://dev.twitch.tv/console/apps to get these.
# Used for all game data (search, detail pages, admin auto-fill) and the
# nightly rating sync worker.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Web Push (VAPID)
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Worker process ──────────────────────────────────────────────────
# Start workers separately: npm run workers:start (PM2) or npm run dev:workers (dev)
# Workers MUST be running for: deal alerts, email, push, newsletters, search indexing

# -----------------------------------------------------------------------------
# OpenAI Moderation API (Comment Toxicity — free, no per-call charge)
# -----------------------------------------------------------------------------
# Get your key at: https://platform.openai.com/api-keys
# When set, new comments are held as PENDING until the toxicity worker classifies them.
# When unset, all comments are auto-approved (no automated moderation).
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Giphy (GIF Search for Comments — free tier available)
# -----------------------------------------------------------------------------
# Get your key at https://developers.giphy.com/ → Create App → API
# Server-side only — never expose to the frontend. Proxied via /api/tenor/search.
# When unset, the GIF button in comments gracefully returns empty results.
GIPHY_API_KEY=

# -----------------------------------------------------------------------------
# Sentry (Error Tracking)
# -----------------------------------------------------------------------------
SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx

# -----------------------------------------------------------------------------
# AdSense
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_ID=ca-pub-xxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Admin IP allowlisting (middleware.ts)
# -----------------------------------------------------------------------------
# Set to "true" to enforce admin IP allowlist on /api/admin/* (default: false — off in dev)
ADMIN_IP_ENFORCE=false
# Comma-separated client IPs permitted to reach /api/admin/* when enforcement is on
ADMIN_IP_ALLOWLIST=127.0.0.1,::1

# -----------------------------------------------------------------------------
# IsThereAnyDeal (Live Price Tracking)
# -----------------------------------------------------------------------------
# Free API key available at https://isthereanydeal.com/dev/app/
# When unset, live deals are disabled and the worker skips price polls gracefully.
ITAD_API_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL — exposed to the browser via Next.js. Used in client-side
#   components for sharing links, canonical URLs in meta tags, etc.
# SITE_URL — server-side only. Used in email templates, RSS feeds, sitemaps.
# Both should point to the same domain. Update both when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Steam (OAuth via OpenID 2.0)
# -----------------------------------------------------------------------------
# Get your API key at: https://steamcommunity.com/dev/apikey
# When unset, Steam sign-in is disabled.
STEAM_API_KEY=

# -----------------------------------------------------------------------------
# E2E test credentials (never use real production credentials here)
# -----------------------------------------------------------------------------
TEST_ADMIN_EMAIL=admin@thecoregamer.com
TEST_ADMIN_PASSWORD=CHANGE_ME_strong_password_here
TEST_EDITOR_EMAIL=editor@thecoregamer.com
TEST_EDITOR_PASSWORD=CHANGE_ME_strong_password_here

# -----------------------------------------------------------------------------
# Algolia (Search)
# -----------------------------------------------------------------------------
# App ID and Admin API key from https://www.algolia.com/account/api-keys
# Admin key must stay server-side only — it can write to indexes.
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=

# -----------------------------------------------------------------------------
# OpenTelemetry — set to 'true' to enable distributed tracing
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=thecoregamer-backend
# Export to Jaeger, Zipkin, or any OTLP-compatible backend:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------------
# Anthropic (AI Writing Assistant — admin editor)
# -----------------------------------------------------------------------------
# Server-side only — never expose to the frontend.
ANTHROPIC_API_KEY=
