# ─── Environment variables — NEVER commit real secrets ────────────────────────
.env
.env.*

# ─── Google service-account key files ─────────────────────────────────────────
*service-account*.json
*service_account*.json
*-credentials.json
*-key.json

# ─── Build / runtime ──────────────────────────────────────────────────────────
.next/
dist/
node_modules/
logs/
*.log

# ─── Auto-generated Prisma client (run `prisma generate` to rebuild) ──────────
src/generated/

# ─── Internal docs & changelog ────────────────────────────────────────────────
README.md
CHANGELOG.md

# ─── One-off test / debug scripts ─────────────────────────────────────────────
test-*.ts
test-*.js

# ─── One-off utility / migration scripts ──────────────────────────────────────
clean-prices.ts
fix-guides.mjs
fix-repeat.ts
manual-deals.ts
manual-index.ts
sync.ts
sync_games.ts
trigger.ts
clear-cache.ts
start-workers.js

# ─── Auto-generated & personal tool configs ───────────────────────────────────
next-env.d.ts
prisma.config.ts

# ─── Nested frontend (belongs in /frontend at root) ───────────────────────────
frontend/

# ─── Prisma: one-off scripts, seeds, SQL patches & archive ────────────────────
prisma/seed*.ts
prisma/fix-*.ts
prisma/fix_*.sql
prisma/patch-*.ts
prisma/migrate-*.ts
prisma/cleanup-*.sql
prisma/migrations_archive*/
prisma/README.md
