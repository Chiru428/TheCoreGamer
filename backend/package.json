{
  "name": "thecoregamer-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate dev",
    "db:migrate:prod": "npm run workers:stop && node --env-file=.env node_modules/prisma/build/index.js migrate deploy && npm run workers:start",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:update-covers": "npx tsx prisma/update-covers.ts",
    "db:upgrade-cover-resolution": "npx tsx scripts/upgrade-cover-resolution.ts",
    "db:clear-content": "npx tsx prisma/clear-content.ts",
    "prepare": "husky",
    "workers:start": "pm2 start ecosystem.config.js",
    "workers:stop": "pm2 stop thecoregamer-workers",
    "workers:restart": "pm2 restart thecoregamer-workers",
    "workers:logs": "pm2 logs thecoregamer-workers",
    "workers:status": "pm2 status",
    "dev:workers": "npx tsx --env-file=.env src/workers/index.ts",
    "email:preview": "email dev --dir src/emails --port 3002"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1039.0",
    "@mux/mux-node": "^14.1.1",
    "@opentelemetry/auto-instrumentations-node": "^0.47.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@prisma/client": "^6.11.1",
    "@prisma/instrumentation": "^6.0.0",
    "@react-email/components": "^0.0.30",
    "@sentry/nextjs": "^10.51.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tiptap/extension-code-block-lowlight": "^3.22.5",
    "@tiptap/extension-color": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-table-cell": "^3.22.5",
    "@tiptap/extension-table-header": "^3.22.5",
    "@tiptap/extension-table-row": "^3.22.5",
    "@tiptap/extension-text-align": "^3.22.5",
    "@tiptap/extension-text-style": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "algoliasearch": "^5.54.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.4",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "file-type": "^19.0.0",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.10.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "next-sitemap": "^4.2.3",
    "otplib": "^12.0.1",
    "pg": "^8.21.0",
    "pino": "^9.6.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-email": "^3.0.7",
    "recharts": "^3.8.1",
    "resend": "^6.12.2",
    "sharp": "^0.34.5",
    "svix": "^1.95.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "web-push": "^3.6.7",
    "web-streams-polyfill": "^4.3.0",
    "zod": "^4.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@jest/types": "^29.6.3",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@types/pino": "^7.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.8.3",
    "prisma": "^6.11.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
